<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Composa</Product>
    <!--
      This tree builds the Chinese trial edition: it is translated by Vibing Coding and answered for by
      Shhzhang, so the publisher signed into the installer and the file properties is not the original
      author. The original work stays attributed in Copyright, as the MIT licence requires.
    -->
    <Authors>Shhzhang</Authors>
    <Company>Shhzhang</Company>
    <Copyright>Copyright (c) 2026 Dennis van der Stelt · 中文试用版（翻译：Vibing Coding，责任作者：Shhzhang）</Copyright>
    <RepositoryUrl>https://github.com/dvdstelt/Composa</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      中文版对外显示的版本号在原版号后加这个后缀：1.4.0 变 1.4.0-CN-R1。
      -R1 是本版自己的修订号：上游没有这个东西，它只用来区分同一上游版本下先后打包的几次中文修正。
    -->
    <ChineseEditionSuffix>-CN-R1</ChineseEditionSuffix>
  </PropertyGroup>

  <!--
    本版的版本号钉在这里，而不是交给 MinVer 从标签推：本仓库的中文版标签长成 1.4.0-CN，
    没有 MinVer 认的 v 前缀，它推不出来（官方发布流程也是显式把版本传进来覆盖它）。
    所以默认钉 1.4.0，让 InformationalVersion 定成 1.4.0-CN-R1。
    只要调用方给了值就不再插手：命令行 -p:、CI 写进环境的 MinVerVersionOverride 优先级都更高，
    发布时照旧由标签决定版本。
  -->
  <PropertyGroup Condition="'$(MinVerVersionOverride)' == ''">
    <MinVerVersionOverride>1.4.0</MinVerVersionOverride>
  </PropertyGroup>

  <!--
    The version comes from the nearest git tag, so a release is cut by tagging and nothing else.
    An untagged commit builds as a pre-release of the next patch; the tag v0.2.0 builds as 0.2.0.
    CI must check out with fetch-depth 0, or MinVer sees no tags and silently versions everything 0.0.0.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    MinVer answers with a plain number, 1.4.0. The Chinese edition shows 1.4.0-CN: only the
    informational version carries the suffix, so AssemblyVersion stays numeric and nothing has to
    re-bind. ReleaseVersion reads "-CN" as a pre-release identifier, so the update check still parses
    it rather than refusing.
  -->
  <Target Name="StampChineseEdition" AfterTargets="MinVer" BeforeTargets="CoreGenerateAssemblyInfo">
    <PropertyGroup>
      <InformationalVersion Condition="!$(InformationalVersion.EndsWith('$(ChineseEditionSuffix)'))">$(InformationalVersion)$(ChineseEditionSuffix)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
